---
const year = new Date().getFullYear();

const socials = [
  { label: 'GitHub', href: 'https://github.com/pourion', icon: 'github' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/pouria-mistani/', icon: 'linkedin' },
  { label: 'Scholar', href: 'https://scholar.google.com/citations?user=2Uos2_gAAAAJ&hl=en', icon: 'scholar' },
  { label: 'YouTube', href: 'https://www.youtube.com/channel/UCGLpaQRR9LAo7oSKQaG9Tzw', icon: 'youtube' },
  { label: 'Email', href: 'mailto:p.a.mistani@gmail.com', icon: 'mail' },
];
---

<footer class="footer">
  <div class="container-wide footer-inner">
    <div class="footer-meta">
      <p class="mono small">
        <span class="dot"></span>
        Building since 2013
      </p>
      <p class="muted small">
        © {year} Pouria Mistani
      </p>
    </div>
    <ul class="footer-socials" aria-label="Social links">
      {socials.map((s) => (
        <li>
          <a href={s.href} target={s.href.startsWith('mailto:') ? '_self' : '_blank'} rel="noopener" class="footer-link mono">
            {s.label}
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--s-32);
    padding-block: var(--s-12) var(--s-8);
    border-top: 1px solid var(--hairline);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-8);
    flex-wrap: wrap;
  }
  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .small {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .mono.small {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.72rem;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }
  .footer-socials {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
  }
  .footer-link {
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.2s var(--ease-out);
  }
  .footer-link:hover { color: var(--accent); }
  .arrow {
    display: inline-block;
    transition: transform 0.25s var(--ease-out);
  }
  .footer-link:hover .arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 640px) {
    .footer-inner { flex-direction: column; }
  }
</style>

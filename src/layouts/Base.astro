---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  hideNav?: boolean;
  image?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'Pouria Mistani — Large-scale simulation of physical systems',
  description = 'Pouria Mistani builds high-fidelity large-scale simulations at the intersection of physics, AI, and supercomputing — from cosmology to biophysics to chip design.',
  hideNav = false,
  image = '/img/Pouria_Mistani.jpg',
  ogType = 'website',
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.origin : 'https://pouriamistani.com';
const absoluteImage = image.startsWith('http') ? image : `${siteOrigin}${image}`;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Pouria Mistani" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Google Analytics (legacy UA — preserved from old site) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-113698782-1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'UA-113698782-1');
    </script>
  </head>
  <body>
    {!hideNav && <Nav />}
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Citation {
  title: string;
  authors: string[];
  publicationDate: string;
  journalTitle: string;
  volume: string | number;
  issue: string | number;
  firstPage?: string | number;
  lastPage?: string | number;
  doi?: string;
  abstractHtmlUrl?: string;
  pdfUrl?: string;
  publisher?: string;
}

interface Props {
  title?: string;
  description?: string;
  hideNav?: boolean;
  image?: string;
  ogType?: 'website' | 'article';
  citation?: Citation;
}

const {
  title = 'Pouria Mistani — Large-scale simulation of physical systems',
  description = 'Pouria Mistani builds high-fidelity large-scale simulations at the intersection of physics, AI, and supercomputing — from cosmology to biophysics to chip design.',
  hideNav = false,
  image = '/img/og-home.png',
  ogType = 'website',
  citation,
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.origin : 'https://pouriamistani.com';
const absoluteImage = image.startsWith('http') ? image : `${siteOrigin}${image}`;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Pouria Mistani" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    {citation && (
      <>
        <meta name="citation_title" content={citation.title} />
        {citation.authors.map((a) => (
          <meta name="citation_author" content={a} />
        ))}
        <meta name="citation_publication_date" content={citation.publicationDate} />
        <meta name="citation_journal_title" content={citation.journalTitle} />
        <meta name="citation_volume" content={String(citation.volume)} />
        <meta name="citation_issue" content={String(citation.issue)} />
        {citation.firstPage !== undefined && (
          <meta name="citation_firstpage" content={String(citation.firstPage)} />
        )}
        {citation.lastPage !== undefined && (
          <meta name="citation_lastpage" content={String(citation.lastPage)} />
        )}
        {citation.doi && <meta name="citation_doi" content={citation.doi} />}
        {citation.abstractHtmlUrl && (
          <meta name="citation_abstract_html_url" content={citation.abstractHtmlUrl} />
        )}
        {citation.pdfUrl && <meta name="citation_pdf_url" content={citation.pdfUrl} />}
        {citation.publisher && <meta name="citation_publisher" content={citation.publisher} />}
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Google Analytics (legacy UA — preserved from old site) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-113698782-1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'UA-113698782-1');
    </script>
  </head>
  <body>
    {!hideNav && <Nav />}
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

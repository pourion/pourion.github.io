---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const links: { href: string; label: string; external?: boolean }[] = [
  { href: '/about', label: 'About' },
  { href: '/publications', label: 'Publications' },
  { href: 'https://stencil.pub', label: 'Stencil', external: true },
];
---

<header class="nav">
  <div class="container-wide nav-inner">
    <a href="/" class="brand mono" aria-label="Pouria Mistani — Home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg">
          <g class="brand-strands" fill="none" stroke-width="2" stroke-linecap="round">
            <line x1="64" y1="20" x2="108" y2="64" />
            <line x1="108" y1="64" x2="64" y2="108" />
            <line x1="64" y1="108" x2="20" y2="64" />
            <line x1="20" y1="64" x2="64" y2="20" />
          </g>
          <circle cx="64" cy="20" r="10" class="brand-star" />
          <circle cx="108" cy="64" r="10" class="brand-star" />
          <circle cx="64" cy="108" r="10" class="brand-star" />
          <circle cx="20" cy="64" r="14" class="brand-star brand-star-amber" />
        </svg>
      </span>
      <span>PM</span>
    </a>
    <nav class="nav-links">
      {links.map((link) => {
        const active = !link.external && (pathname === link.href || pathname.startsWith(link.href + '/'));
        return (
          <a
            href={link.href}
            class={`nav-link mono${active ? ' is-active' : ''}`}
            {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    background: var(--bg-veil);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease-out);
  }
  .nav.is-scrolled {
    border-bottom-color: var(--hairline);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--ink);
    background: none;
    text-decoration: none;
  }
  .brand:hover { color: var(--accent); }
  .brand-mark {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    display: inline-flex;
  }
  .brand-mark svg {
    width: 100%;
    height: 100%;
    display: block;
    transform-origin: 50% 50%;
    transition: transform 0.55s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .brand-strands {
    stroke: var(--ink-muted);
    opacity: 0.35;
  }
  .brand-star {
    fill: var(--ink);
  }
  .brand-star-amber {
    fill: var(--accent);
    filter: drop-shadow(0 0 6px rgba(230, 162, 60, 0.55));
  }
  .brand:hover .brand-mark svg {
    transform: rotate(90deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-mark svg { transition: none; }
    .brand:hover .brand-mark svg { transform: none; }
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }
  .nav-link {
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: none;
    transition: color 0.2s var(--ease-out);
  }
  .nav-link:hover, .nav-link.is-active {
    color: var(--ink);
  }
  .nav-link.is-active {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.5em;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 640px) {
    .nav-links { gap: 1.25rem; }
    .nav-link { font-size: 0.68rem; }
  }
</style>

<script>
  const nav = document.querySelector('.nav');
  if (nav) {
    const onScroll = () => {
      if (window.scrollY > 12) nav.classList.add('is-scrolled');
      else nav.classList.remove('is-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

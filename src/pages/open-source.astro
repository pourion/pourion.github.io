---
import Base from '../layouts/Base.astro';
import { CONTRIBUTIONS, LIBRARIES } from '../data/opensource';
---

<Base title="Open source — Pouria Mistani" description="Merged contributions to upstream open-source projects, including AMReX and VERL, and the libraries developed by Pouria Mistani.">
  <section class="oss-hero">
    <div class="container-wide">
      <p class="eyebrow">Open source</p>
      <h1 class="oss-hero-title">Contributions to <em>scientific and machine-learning</em> software.</h1>
      <p class="muted oss-hero-note">
        This page lists my merged contributions to upstream projects and the libraries I develop.
        More code is on <a href="https://github.com/pourion" target="_blank" rel="noopener">GitHub</a>.
      </p>
    </div>
  </section>

  <section class="oss-section container-wide">
    <header class="oss-section-head">
      <p class="eyebrow">Upstream projects</p>
      <h2>Contributions.</h2>
    </header>
    <ul class="oss-grid">
      {CONTRIBUTIONS.map((c) => (
        <li class="oss-card">
          <p class="oss-meta mono">
            <a href={c.projectHref} target="_blank" rel="noopener" class="oss-project">{c.project}</a>
            <span class="oss-sep" aria-hidden="true">·</span>
            <span>{c.date}</span>
          </p>
          <h3 class="oss-title">{c.title}</h3>
          <p class="oss-status mono">{c.status}</p>
          {c.paragraphs.map((p) => <p class="oss-text">{p}</p>)}
          <p class="oss-links mono">
            {c.links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener">{l.label}<span class="arrow" aria-hidden="true"> ↗</span></a>
            ))}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="oss-section container-wide">
    <header class="oss-section-head">
      <p class="eyebrow">Libraries</p>
      <h2>Libraries I develop.</h2>
    </header>
    <ul class="oss-grid">
      {LIBRARIES.map((l) => (
        <li class="oss-card">
          <p class="oss-meta mono">
            <span class="oss-role">{l.role}</span>
            <span class="oss-sep" aria-hidden="true">·</span>
            <span>{l.years}</span>
          </p>
          <h3 class="oss-title">{l.name}</h3>
          {l.paragraphs.map((p) => <p class="oss-text">{p}</p>)}
          <p class="oss-links mono">
            {l.links.map((k) => (
              <a href={k.href} target="_blank" rel="noopener">{k.label}<span class="arrow" aria-hidden="true"> ↗</span></a>
            ))}
          </p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .oss-hero {
    padding-block: var(--s-24) var(--s-12);
    border-bottom: 1px solid var(--hairline);
  }
  .oss-hero-title {
    font-size: clamp(2rem, 5vw, 3.8rem);
    line-height: 1.05;
    margin-top: var(--s-4);
    margin-bottom: var(--s-4);
    max-width: 22ch;
  }
  .oss-hero-title em {
    color: var(--accent);
    font-style: italic;
    font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
  }
  .oss-hero-note {
    font-size: 0.95rem;
  }

  .oss-section {
    padding-block: var(--s-12);
  }
  .oss-section-head {
    margin-bottom: var(--s-8);
  }
  .oss-section-head h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }

  .oss-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-6);
    padding: 0;
  }
  .oss-card {
    display: flex;
    flex-direction: column;
    padding: var(--s-6) var(--s-6) var(--s-6);
    border: 1px solid var(--hairline);
    background: var(--bg-elevated);
    transition: border-color 0.25s var(--ease-out);
  }
  .oss-card:hover {
    border-color: var(--hairline-strong);
  }
  .oss-meta {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--s-3);
  }
  .oss-project,
  .oss-role {
    color: var(--accent);
  }
  .oss-project {
    background-image: none;
  }
  .oss-sep {
    margin: 0 0.6em;
    color: var(--ink-dim);
  }
  .oss-title {
    font-size: 1.4rem;
    line-height: 1.25;
    margin-bottom: var(--s-2);
  }
  .oss-status {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
    margin-bottom: var(--s-4);
  }
  .oss-text {
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: var(--s-3);
  }
  .oss-links {
    margin-top: auto;
    padding-top: var(--s-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .oss-grid { grid-template-columns: 1fr; }
  }
</style>

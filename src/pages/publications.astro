---

<Base title="Publications — Pouria Mistani" description="Papers, patents, thesis, preprints, book chapters, conference presentations and talks by Pouria Mistani.">
  <section class="pubs-hero">
    <div class="container-wide">
      <p class="eyebrow">Publications &amp; patents</p>
      <h1 class="pubs-hero-title">Papers, <em>patents</em>, preprints and talks.</h1>
      <p class="muted pubs-hero-note">
        The list follows my
        <a href="https://scholar.google.com/citations?user=2Uos2_gAAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar profile</a>.
      </p>

    </div>
  </section>

  <section class="pubs-section container-wide">
    <header class="pubs-section-head">
      <p class="eyebrow">Peer-reviewed papers</p>
      <h2>Papers.</h2>
    </header>
    <ol class="pubs-list">
      {papers.map((p) => (
        <li class={`pub-row${p.highlight ? ' is-highlight' : ''}`}>
          <span class="pub-year mono">{p.year}</span>
          <div class="pub-body">
            <p class="pub-title">
              {p.href
                ? <a href={p.href} target="_blank" rel="noopener">{p.title}<span class="arrow" aria-hidden="true">↗</span></a>
                : p.title}
            </p>
            <p class="pub-meta mono">
              <span class="pub-authors">{p.authors}</span>
              <span class="pub-sep">·</span>
              <span class="pub-venue">{p.venue}</span>
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="pubs-section container-wide">
    <header class="pubs-section-head">
      <p class="eyebrow">Patents</p>
      <h2>Patents.</h2>
    </header>
    <ol class="pubs-list">
      {patents.map((p) => (
        <li class="pub-row">
          <span class="pub-year mono">{p.year}</span>
          <div class="pub-body">
            <p class="pub-title">{p.title}</p>
            <p class="pub-meta mono">
              <span>{p.inventors}</span>
              <span class="pub-sep">·</span>
              <span>{p.id}</span>
              <span class="pub-sep">·</span>
              <span class="pub-affil">{p.affiliation}</span>
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="pubs-section container-wide">
    <header class="pubs-section-head">
      <p class="eyebrow">Preprints &amp; thesis</p>
      <h2>Preprints &amp; thesis.</h2>
    </header>
    <ol class="pubs-list">
      {preprintsAndThesis.map((p) => (
        <li class={`pub-row${p.highlight ? ' is-highlight' : ''}`}>
          <span class="pub-year mono">{p.year}</span>
          <div class="pub-body">
            <p class="pub-title">
              {p.href
                ? <a href={p.href} target="_blank" rel="noopener">{p.title}<span class="arrow" aria-hidden="true">↗</span></a>
                : p.title}
            </p>
            <p class="pub-meta mono">
              <span class="pub-authors">{p.authors}</span>
              <span class="pub-sep">·</span>
              <span class="pub-venue">{p.venue}</span>
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="pubs-section container-wide">
    <header class="pubs-section-head">
      <p class="eyebrow">Book chapters</p>
      <h2>Book chapters.</h2>
    </header>
    <ol class="pubs-list">
      {bookChapters.map((p) => (
        <li class="pub-row">
          <span class="pub-year mono">{p.year}</span>
          <div class="pub-body">
            <p class="pub-title">
              {p.href
                ? <a href={p.href} target="_blank" rel="noopener">{p.title}<span class="arrow" aria-hidden="true">↗</span></a>
                : p.title}
            </p>
            <p class="pub-meta mono">
              <span class="pub-authors">{p.authors}</span>
              <span class="pub-sep">·</span>
              <span class="pub-venue">{p.venue}</span>
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="pubs-section container-wide">
    <header class="pubs-section-head">
      <p class="eyebrow">Conferences &amp; posters</p>
      <h2>Conferences.</h2>
    </header>
    <ol class="pubs-list">
      {conferences.map((p) => (
        <li class="pub-row">
          <span class="pub-year mono">{p.year}</span>
          <div class="pub-body">
            <p class="pub-title">
              {p.href
                ? <a href={p.href} target="_blank" rel="noopener">{p.title}<span class="arrow" aria-hidden="true">↗</span></a>
                : p.title}
            </p>
            <p class="pub-meta mono">
              <span class="pub-authors">{p.authors}</span>
              <span class="pub-sep">·</span>
              <span class="pub-venue">{p.venue}</span>
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="pubs-section container-wide">
    <header class="pubs-section-head">
      <p class="eyebrow">Open source</p>
      <h2>Open-source software.</h2>
    </header>
    <p class="pubs-pointer">
      Libraries and contributions to upstream projects are listed on the <a href="/open-source">open-source page</a>.
    </p>
  </section>

  <section class="pubs-section container-wide">
    <header class="pubs-section-head">
      <p class="eyebrow">Invited talks</p>
      <h2>Selected talks.</h2>
    </header>
    <ol class="pubs-list">
      {talks.map((t) => (
        <li class="pub-row">
          <span class="pub-year mono">{t.year}</span>
          <div class="pub-body">
            <p class="pub-title">
              {t.href
                ? <a href={t.href} target="_blank" rel="noopener">{t.title}<span class="arrow" aria-hidden="true">↗</span></a>
                : t.title}
            </p>
            <p class="pub-meta mono">{t.venue}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .pubs-hero {
    padding-block: var(--s-24) var(--s-12);
    border-bottom: 1px solid var(--hairline);
  }
  .pubs-hero-title {
    font-size: clamp(2rem, 5vw, 3.8rem);
    line-height: 1.05;
    margin-top: var(--s-4);
    margin-bottom: var(--s-4);
    max-width: 22ch;
  }
  .pubs-hero-title em {
    color: var(--accent);
    font-style: italic;
    font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
  }
  .pubs-hero-note {
    font-size: 0.95rem;
  }
  .pubs-hero-note a {
    color: var(--accent);
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
  }

  .pubs-section {
    padding-block: var(--s-12);
  }
  .pubs-section-head {
    margin-bottom: var(--s-8);
  }
  .pubs-section-head h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }

  .pubs-list {
    list-style: none;
    padding: 0;
    counter-reset: pub;
  }
  .pub-row {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--s-6);
    padding: var(--s-6) 0;
    border-top: 1px solid var(--hairline);
    align-items: baseline;
  }
  .pub-row:last-child { border-bottom: 1px solid var(--hairline); }
  .pub-row.is-highlight {
    background: linear-gradient(to right, rgba(230, 162, 60, 0.04), transparent 70%);
  }
  .pub-row.is-highlight .pub-year::before {
    content: '★ ';
    color: var(--accent);
  }
  .pub-year {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .pub-title {
    font-size: 1.1rem;
    line-height: 1.35;
    margin-bottom: var(--s-2);
    max-width: 65ch;
  }
  .pub-title a {
    color: var(--ink);
    background-image: none;
    display: inline;
    transition: color 0.2s var(--ease-out);
  }
  .pub-title a:hover { color: var(--accent); }
  .pub-title .arrow {
    display: inline-block;
    margin-left: 0.35rem;
    color: var(--ink-dim);
    font-size: 0.85em;
    transition: transform 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }
  .pub-title a:hover .arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  .pub-meta {
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--ink-muted);
    line-height: 1.45;
  }
  .pub-sep {
    margin: 0 0.5rem;
    color: var(--ink-dim);
  }
  .pub-authors strong { color: var(--ink); }
  .pub-affil {
    color: var(--accent);
  }

  .pubs-pointer {
    color: var(--ink-muted);
  }
  .pubs-pointer a {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .pub-row { grid-template-columns: 1fr; gap: var(--s-2); }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Constellation from '../components/Constellation.astro';

const foundings = [
  {
    year: '2021',
    org: 'NVIDIA',
    team: 'Clara Discovery Simulation',
    blurb: 'First technical hire. I helped establish AI-driven simulation for drug discovery and grow the team to 14 engineers and researchers. The work included DiffDock in BioNeMo and GPU molecular dynamics with machine-learned interaction potentials.',
  },
  {
    year: '2024',
    org: 'Aikium',
    team: 'Computational platform',
    blurb: 'Founding scientist. I developed multi-objective DPO for protein language models and filed three provisional patents within four months. The algorithm later became the basis of Aikium\'s production drug-design platform.',
  },
  {
    year: '2024',
    org: 'Synopsys',
    team: 'GenAI Solutions',
    blurb: 'Founding engineer. I built a GenAI SDK and a multi-agent EDA framework that were adopted by several business units. I am the lead inventor on the patent application for the framework.',
  },
  {
    year: '2025',
    org: 'Voltai',
    team: 'Voltaire · Platform Lead',
    blurb: 'I conceived Voltaire, built the initial platform and defined its architecture. I also assembled the team, which has expertise in AI, computational science and semiconductor engineering.',
  },
];

const announcement = {
  date: 'Oct 2026',
  text: 'NVIDIA described Voltaire in its SEMICON West announcement. Voltaire is the agentic multiphysics platform for 3D-IC design that I conceived and lead at Voltai.',
  links: [
    { label: 'Voltai announcement', href: 'https://voltai.com/blog/voltai-nvidia-voltaire-3d-ic-design' },
    { label: 'NVIDIA release', href: 'https://nvidianews.nvidia.com/news/nvidia-and-semiconductor-leaders-advance-ai-across-chip-design-and-manufacturing-for-ai-defined-labs' },
  ],
};

const featuredProjects = [
  {
    title: 'Voltaire',
    role: 'Voltai · 2025 – now',
    blurb: 'An agentic multiphysics platform for 3D-IC design. GPU-accelerated first-principles solvers compute the electrical, thermal and mechanical behavior, and AI agents coordinate the workflow. Electromagnetic extraction runs 32 times faster on eight H100 GPUs than on a 64-CPU baseline at the same accuracy.',
    image: '/img/sky130_fd_sc_hd__sedfxbp_2-transparent.png',
    href: 'https://voltai.com/blog/voltai-nvidia-voltaire-3d-ic-design',
    external: true,
  },
  {
    title: 'Multi-objective DPO',
    role: 'Aikium · 2024',
    blurb: 'Multi-objective preference optimization for protein and molecule language models. Three provisional patents were filed within four months, and the algorithm later became the basis of Aikium\'s production drug-design platform. Published at the ICLR 2024 GEM workshop.',
    image: '/img/dpo_aikium.png',
    href: '#trajectory',
  },
  {
    title: 'Multi-agent EDA framework',
    role: 'Synopsys · 2024 – 2025',
    blurb: 'As a founding engineer of the GenAI Solutions team, I designed a multi-agent framework for EDA workflows. I am the lead inventor on the Synopsys patent application. Engineering Excellence award, selected from approximately 2,000 engineers.',
    image: '/img/synopsys-agents.svg',
    href: '#trajectory',
  },
  {
    title: 'JAX-DIPS',
    role: 'Open source · lead',
    blurb: 'A differentiable 3D solver for interfacial PDEs, written in JAX for GPUs, TPUs and CPUs. It uses neural bootstrapping of finite discretization methods to solve elliptic problems with jump conditions. Journal of Computational Physics, 2023.',
    image: '/img/jaxdips.png',
    href: 'https://github.com/JAX-DIPS/JAX-DIPS',
    external: true,
  },
  {
    title: 'Clara Discovery · MLIP-driven MD',
    role: 'NVIDIA · 2021 – 2023',
    blurb: 'GPU molecular dynamics driven by machine-learned interaction potentials (MLIPs) in place of classical force fields. The implementation achieved a 5-fold speed-up and a 10-fold improvement in memory efficiency.',
    image: '/img/nvidia-clara.png',
    href: '#trajectory',
  },
  {
    title: 'AVICENNA',
    role: 'UCSB · CASL Lab',
    blurb: 'The first parallel, multiscale 3D simulation code for tissue-scale electroporation of cell aggregates. Simulations were run on national supercomputers. The work was featured by the U.S. Army Research Laboratory, TACC and XSEDE.',
    image: '/img/2_EP.jpg',
    href: '#trajectory',
  },
];

const talks = [
  {
    title: 'ICIAM 2023 · invited talk',
    href: 'https://www.youtube.com/embed/ACjiRyOh-E0',
    blurb: 'Differentiable PDE solvers and AI for simulation.',
  },
  {
    title: '2020 · research overview',
    href: 'https://www.youtube.com/embed/NrMaIaaXlM4',
    blurb: 'Level-set methods, AVICENNA and large-scale biophysical simulation.',
  },
];
---

<Base
  title="Pouria Mistani — AI for Science & Engineering"
  description="Pouria Mistani is a computational physicist who leads teams building AI for physics-based engineering design. His work covers physics simulation, high-performance computing and scientific machine learning, with applications in cosmology, biophysics and 3D-IC design."
  image="/img/og-home.png"
>
  {/* Hero */}
  <section class="hero">
    <div class="container-wide hero-inner">
      <p class="eyebrow hero-eyebrow">
        <span class="dot"></span>
        Pouria Mistani, PhD · AI for Science &amp; Engineering
      </p>
      <h1 class="hero-title">
        Computational physicist. I lead teams building <em>AI for physics-based engineering design</em>.
      </h1>
      <p class="hero-lede">
        I trained in cosmology and in numerical methods for partial differential equations. For
        more than a decade I have built large-scale simulations and the machine-learning methods
        coupled to them, at UC Santa Barbara, Merck, NVIDIA and Synopsys. I currently lead Voltaire,
        Voltai's agentic multiphysics platform for 3D-IC design.
      </p>
      <div class="hero-actions">
        <a href="#trajectory" class="button button-accent">See the trajectory ↓</a>
        <a href="/publications" class="hero-link mono">Publications →</a>
        <a href="/about" class="hero-link mono">About →</a>
      </div>
    </div>
    <div class="hero-grid" aria-hidden="true"></div>
  </section>

  {/* Latest — public announcement */}
  <section class="announce container-wide" aria-label="Latest">
    <p class="announce-date mono">{announcement.date}</p>
    <p class="announce-text">{announcement.text}</p>
    <p class="announce-links mono">
      {announcement.links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener">{l.label}<span aria-hidden="true"> ↗</span></a>
      ))}
    </p>
  </section>

  {/* Constellation — centerpiece */}
  <Constellation />

  {/* Founding-team pattern */}
  <section class="foundings container-wide" id="foundings">
    <div class="foundings-head">
      <p class="eyebrow">Teams and platforms</p>
      <h2 class="foundings-title">
        Four teams joined at the <em>founding stage</em>.
      </h2>
      <p class="foundings-lede muted">
        In each of these positions I was the first technical hire, a founding engineer or the
        platform lead. I built the first working system and helped grow the team.
      </p>
    </div>
    <ol class="foundings-list">
      {foundings.map((f, i) => (
        <li class="founding-row">
          <span class="founding-index mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="founding-year mono">{f.year}</span>
          <div class="founding-body">
            <p class="founding-org">
              <span class="founding-org-name">{f.org}</span>
              <span class="founding-sep" aria-hidden="true">·</span>
              <span class="founding-team">{f.team}</span>
            </p>
            <p class="founding-blurb">{f.blurb}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  {/* Current focus */}
  <section class="focus container-narrow">
    <p class="eyebrow">Current focus</p>
    <h2 class="focus-title">
      Semiconductor design based on <em>first-principles simulation</em>, with
      <em>AI agents</em> coordinating the design workflow.
    </h2>
    <p class="focus-body">
      The physics of an integrated circuit is well posed and well characterized. It is described by
      Maxwell's equations, heat and charge transport, and elasticity. Manufacturing processes such as
      epitaxy, etching and lithography are modeled by the level-set evolution of free boundaries. The
      problems are large enough to require accelerated numerical methods, and design decisions depend
      on accurate results. The engineering workflow around these simulations is complex. AI agents can
      automate this workflow, verify results and explore design alternatives in parallel. My aim is to
      build simulations for industrial design with the scale and fidelity that the Illustris
      simulations achieved in cosmology.
    </p>
  </section>

  {/* Featured projects */}
  <section class="projects container-wide">
    <div class="projects-head">
      <p class="eyebrow">Selected work</p>
      <h2>Selected projects, 2018 – 2026.</h2>
    </div>
    <ul class="project-grid">
      {featuredProjects.map((p, i) => (
        <li class="project-card" style={`--i: ${i}`}>
          <a
            href={p.href}
            class="project-link"
            target={p.external ? '_blank' : '_self'}
            rel={p.external ? 'noopener' : undefined}
          >
            <div class="project-image">
              <img src={p.image} alt={p.title} loading="lazy" />
            </div>
            <div class="project-body">
              <p class="project-role mono">{p.role}</p>
              <h3 class="project-title">{p.title}</h3>
              <p class="project-blurb">{p.blurb}</p>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* Talks */}
  <section class="talks container-wide">
    <p class="eyebrow">Talks</p>
    <h2>Selected talks.</h2>
    <ul class="talks-grid">
      {talks.map((t) => (
        <li class="talk-card">
          <div class="talk-frame">
            <iframe
              src={t.href}
              title={t.title}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
          <h3 class="talk-title">{t.title}</h3>
          <p class="talk-blurb muted">{t.blurb}</p>
        </li>
      ))}
    </ul>
  </section>

  {/* Contact CTA */}
  <section class="contact container-narrow">
    <p class="eyebrow">Get in touch</p>
    <h2 class="contact-title">
      For collaboration on AI for science, engineering design or large-scale simulation, <em>please write</em>.
    </h2>
    <div class="contact-actions">
      <a href="mailto:p.a.mistani@gmail.com" class="button button-accent">
        p.a.mistani@gmail.com
      </a>
      <a href="https://www.linkedin.com/in/pouria-mistani/" target="_blank" rel="noopener" class="hero-link mono">
        LinkedIn →
      </a>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-block: clamp(5rem, 14vw, 11rem) clamp(3rem, 8vw, 7rem);
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--hairline) 1px, transparent 1px),
      linear-gradient(to bottom, var(--hairline) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse at 50% 30%, black 0%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 30%, black 0%, transparent 75%);
    opacity: 0.4;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
  }
  .hero-eyebrow {
    max-width: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: var(--s-12);
  }
  .hero-eyebrow .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 12px var(--accent); }
    50%      { opacity: 0.55; box-shadow: 0 0 22px var(--accent); }
  }
  .hero-title {
    font-size: clamp(2.5rem, 6.4vw, 5.6rem);
    line-height: 1.02;
    font-weight: 320;
    letter-spacing: -0.03em;
    max-width: 19ch;
    margin-bottom: var(--s-8);
  }
  .hero-title em {
    color: var(--accent);
    font-style: italic;
  }
  .hero-lede {
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: 56ch;
    margin-bottom: var(--s-12);
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    flex-wrap: wrap;
  }
  .hero-link {
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: none;
    transition: color 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }
  .hero-link:hover {
    color: var(--accent);
    transform: translateX(3px);
  }

  /* Latest announcement */
  .announce {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: var(--s-6);
    align-items: baseline;
    padding-block: var(--s-8);
    border-bottom: 1px solid var(--hairline);
  }
  .announce-date {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .announce-text {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.45;
    color: var(--ink-strong);
    max-width: 60ch;
  }
  .announce-links {
    display: flex;
    gap: var(--s-6);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .announce-links a {
    color: var(--ink-muted);
  }
  .announce-links a:hover {
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .announce {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
    .announce-links {
      flex-wrap: wrap;
      white-space: normal;
    }
  }


  /* Foundings */
  .foundings {
    padding-block: var(--s-16) var(--s-12);
    border-top: 1px solid var(--hairline);
  }
  .foundings-head {
    margin-bottom: var(--s-12);
    max-width: 60ch;
  }
  .foundings-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.05;
    margin-bottom: var(--s-4);
  }
  .foundings-title em {
    color: var(--accent);
    font-style: italic;
  }
  .foundings-lede {
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 56ch;
  }
  .foundings-list {
    list-style: none;
    padding: 0;
    counter-reset: founding;
  }
  .founding-row {
    display: grid;
    grid-template-columns: 50px 120px 1fr;
    gap: var(--s-6);
    padding: var(--s-6) 0;
    border-top: 1px solid var(--hairline);
    align-items: baseline;
    transition: background 0.25s var(--ease-out);
  }
  .founding-row:last-child {
    border-bottom: 1px solid var(--hairline);
  }
  .founding-row:hover {
    background: linear-gradient(to right, rgba(230, 162, 60, 0.04), transparent 60%);
  }
  .founding-index {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .founding-year {
    font-size: 0.86rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .founding-org {
    font-size: 1.15rem;
    line-height: 1.3;
    margin-bottom: var(--s-2);
    max-width: none;
    color: var(--ink-strong);
  }
  .founding-org-name {
    font-weight: 420;
  }
  .founding-team {
    color: var(--ink-muted);
    font-style: italic;
  }
  .founding-sep {
    margin: 0 0.5em;
    color: var(--ink-dim);
  }
  .founding-blurb {
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 65ch;
  }

  @media (max-width: 768px) {
    .founding-row {
      grid-template-columns: 40px 1fr;
      grid-template-areas:
        "idx year"
        "idx body";
      row-gap: var(--s-2);
    }
    .founding-index { grid-area: idx; }
    .founding-year  { grid-area: year; }
    .founding-body  { grid-area: body; }
  }

  /* Focus */
  .focus {
    padding-block: var(--s-24);
    text-align: left;
  }
  .focus-title {
    font-size: clamp(1.8rem, 3.6vw, 2.9rem);
    line-height: 1.1;
    margin-bottom: var(--s-8);
    letter-spacing: -0.02em;
  }
  .focus-title em {
    color: var(--accent);
    font-style: italic;
  }
  .focus-body {
    color: var(--ink-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 60ch;
  }

  /* Projects */
  .projects {
    padding-block: var(--s-16) var(--s-24);
  }
  .projects-head {
    margin-bottom: var(--s-12);
  }
  .projects-head h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
  }
  .project-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--s-6);
    padding: 0;
  }
  /* Asymmetric editorial grid */
  .project-card:nth-child(1) { grid-column: span 8; }
  .project-card:nth-child(2) { grid-column: span 4; }
  .project-card:nth-child(3) { grid-column: span 4; }
  .project-card:nth-child(4) { grid-column: span 8; }
  .project-card:nth-child(5) { grid-column: span 5; }
  .project-card:nth-child(6) { grid-column: span 7; }

  .project-link {
    display: block;
    background: var(--bg-elevated);
    border: 1px solid var(--hairline);
    height: 100%;
    text-decoration: none;
    background-image: none;
    color: var(--ink);
    position: relative;
    overflow: hidden;
    transition: border-color 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }
  .project-link:hover {
    border-color: var(--accent);
    color: var(--ink);
    transform: translateY(-3px);
  }
  .project-link:hover .project-arrow {
    transform: translate(4px, -4px);
    color: var(--accent);
  }
  .project-link:hover .project-image img {
    transform: scale(1.04);
  }

  .project-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg);
    border-bottom: 1px solid var(--hairline);
  }
  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.8) contrast(1.05);
    transition: transform 0.6s var(--ease-out);
  }
  .project-body {
    padding: var(--s-6);
    position: relative;
  }
  .project-role {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--s-3);
  }
  .project-title {
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    margin-bottom: var(--s-3);
    line-height: 1.15;
  }
  .project-blurb {
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 50ch;
  }
  .project-arrow {
    position: absolute;
    top: var(--s-6);
    right: var(--s-6);
    font-size: 1.1rem;
    color: var(--ink-dim);
    transition: transform 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  /* Talks */
  .talks {
    padding-block: var(--s-16) var(--s-24);
  }
  .talks h2 {
    margin-bottom: var(--s-12);
  }
  .talks-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-8);
    padding: 0;
  }
  .talk-card {
    display: flex;
    flex-direction: column;
  }
  .talk-frame {
    aspect-ratio: 16 / 9;
    background: var(--bg-elevated);
    border: 1px solid var(--hairline);
    overflow: hidden;
    margin-bottom: var(--s-4);
  }
  .talk-frame iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
  .talk-title {
    font-size: 1.2rem;
    margin-bottom: var(--s-2);
  }
  .talk-blurb {
    font-size: 0.95rem;
  }

  /* Contact */
  .contact {
    padding-block: var(--s-16) var(--s-24);
  }
  .contact-title {
    font-size: clamp(1.8rem, 3.6vw, 2.9rem);
    line-height: 1.1;
    margin-bottom: var(--s-8);
    letter-spacing: -0.02em;
  }
  .contact-title em {
    color: var(--accent);
    font-style: italic;
  }
  .contact-actions {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    flex-wrap: wrap;
  }

  /* Responsive */
  @media (max-width: 880px) {
    .project-card { grid-column: span 12 !important; }
    .talks-grid { grid-template-columns: 1fr; }
  }
</style>

---
import Base from '../../layouts/Base.astro';

const posts: { title: string; href: string; date: string; blurb: string }[] = [
  {
    title: 'Toward a Simulation Organism',
    href: '/blog/toward-a-simulation-ai-organism/',
    date: 'May 2026',
    blurb: 'A paradigm note. AI as a co-designer of the solver — embedded in the building blocks of an exascale simulation, learning iron laws of design from comparison against benchmarks and experiment, accumulating skill across the pillars of classical physics.',
  },
];
---

<Base title="Blog — Pouria Mistani" description="Writing on physics simulation, scientific ML, and the engineering of large-scale platforms.">
  <section class="blog-hero">
    <div class="container-wide">
      <p class="eyebrow">Blog</p>
      <h1 class="blog-hero-title">
        Notes on physics simulation, <em>scientific ML</em>, and the engineering of large-scale platforms.
      </h1>
    </div>
  </section>

  <section class="blog-list container-wide">
    {posts.length === 0 ? (
      <div class="empty-state">
        <p class="eyebrow">Coming soon</p>
        <h2>The first post is on the way.</h2>
        <p class="muted empty-body">
          I'm preparing a sequence on domain decomposition for PDE solvers, the geometry of
          neural operators, and the engineering reality of running exascale simulations on
          GPU clusters. In the meantime, see my
          <a href="/publications">papers</a> or
          reach out by <a href="mailto:p.a.mistani@gmail.com">email</a>.
        </p>
      </div>
    ) : (
      <ol class="post-list">
        {posts.map((p) => (
          <li class="post-row">
            <span class="post-date mono">{p.date}</span>
            <div class="post-body">
              <h3 class="post-title"><a href={p.href}>{p.title}</a></h3>
              <p class="post-blurb muted">{p.blurb}</p>
            </div>
          </li>
        ))}
      </ol>
    )}
  </section>
</Base>

<style>
  .blog-hero {
    padding-block: var(--s-24) var(--s-12);
    border-bottom: 1px solid var(--hairline);
  }
  .blog-hero-title {
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.05;
    margin-top: var(--s-4);
    max-width: 26ch;
  }
  .blog-hero-title em {
    color: var(--accent);
    font-style: italic;
    font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
  }

  .blog-list {
    padding-block: var(--s-16) var(--s-24);
  }
  .empty-state {
    padding: var(--s-12) 0;
    text-align: center;
  }
  .empty-state h2 {
    margin-top: var(--s-3);
    margin-bottom: var(--s-6);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
  }
  .empty-body {
    max-width: 50ch;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .empty-body a {
    color: var(--accent);
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
  }

  .post-list {
    list-style: none;
    padding: 0;
  }
  .post-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: var(--s-6);
    padding: var(--s-6) 0;
    border-top: 1px solid var(--hairline);
  }
  .post-row:last-child { border-bottom: 1px solid var(--hairline); }
  .post-date {
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .post-title { font-size: 1.4rem; margin-bottom: var(--s-2); }
  .post-title a { background-image: none; color: var(--ink); }
  .post-title a:hover { color: var(--accent); }
  .post-blurb { font-size: 0.95rem; max-width: 60ch; }

  @media (max-width: 768px) {
    .post-row { grid-template-columns: 1fr; gap: var(--s-2); }
  }
</style>

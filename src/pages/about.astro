---
import Base from '../layouts/Base.astro';

const experience = [
  {
    years: '2025 – now',
    role: 'Platform Lead, Voltaire · Member of Technical Staff',
    org: 'Voltai',
    note: 'Conceived and lead Voltaire, an agentic multiphysics platform for 3D-IC design. GPU-accelerated first-principles solvers form its core, and AI agents coordinate the workflow. Electromagnetic extraction runs 32 times faster on eight NVIDIA H100 GPUs than on a 64-CPU baseline at the same accuracy. NVIDIA described the platform in its SEMICON West 2026 announcement.',
    links: [
      { label: 'Announcement', href: 'https://voltai.com/blog/voltai-nvidia-voltaire-3d-ic-design' },
      { label: 'NVIDIA release', href: 'https://nvidianews.nvidia.com/news/nvidia-and-semiconductor-leaders-advance-ai-across-chip-design-and-manufacturing-for-ai-defined-labs' },
    ],
  },
  {
    years: '2024 – 2025',
    role: 'Senior Staff AI Engineer',
    org: 'Synopsys',
    note: 'Founding engineer of the GenAI Solutions team. Built an internal GenAI SDK that was adopted across business units. Designed a multi-agent EDA framework and am the lead inventor on its patent application. Technical lead for foundation models for physical circuit design. Engineering Excellence award.',
  },
  {
    years: '2024',
    role: 'Principal Deep Learning Scientist',
    org: 'Aikium',
    note: 'Developed multi-objective DPO for protein and molecule language models. The work resulted in three provisional patents and an ICLR 2024 GEM workshop paper.',
  },
  {
    years: '2023',
    role: 'Machine Learning Scientist',
    org: 'Genentech · Prescient Design',
    note: 'Therapeutic protein design.',
  },
  {
    years: '2021 – 2023',
    role: 'Senior Software Engineer, AI & HPC',
    org: 'NVIDIA',
    note: 'First technical hire on the Clara Discovery simulation team, which grew to 14 engineers and researchers. Implemented DiffDock in BioNeMo. Developed GPU molecular dynamics with machine-learned interaction potentials, which achieved a 5-fold speed-up and a 10-fold improvement in memory efficiency. Collaborated with the Clara, Modulus and Warp teams.',
  },
  {
    years: '2020 – 2021',
    role: 'Postdoctoral Research Fellow',
    org: 'Merck Research Laboratories',
    note: 'Developed a CUDA/C++ Monte Carlo code for the second virial coefficient of biologics. Received a $75,000 seed grant to build an HPC platform for protein aggregation.',
  },
];

const researchAreas = [
  'Multiphysics simulation',
  'Numerical PDEs & level-set methods',
  'GPU & multi-node HPC',
  'Differentiable simulation',
  'Scientific machine learning',
  'Neural operators',
  'Agentic AI systems',
  'Reinforcement learning',
  'LLM post-training',
];

const education = [
  { years: '2016 – 2020', degree: 'PhD · Mechanical Engineering (CSE)', org: 'UC Santa Barbara', note: 'Level-set methods for elliptic PDEs with irregular free boundaries. Reduced-order stochastic theory for the interfacial polarization of cell aggregates.' },
  { years: '2013 – 2016', degree: 'MS · Physics (Computational Astrophysics)', org: 'UC Riverside', note: 'Theory of dwarf-galaxy formation and analysis of data from the Illustris Simulation Suite.' },
  { years: '2008 – 2013', degree: 'BS · Physics  ·  BS · Aerospace Engineering', org: 'Sharif University of Technology', note: 'Dual undergraduate degrees.' },
];

const awards = [
  { year: 2025, label: 'Engineering Excellence Group Individual Award for Outstanding AI Contributions, Synopsys, selected from approximately 2,000 engineers' },
  { year: 2021, label: '$75,000 seed grant for HPC modeling of protein aggregation, Merck Research Laboratories' },
  { year: 2020, label: 'Graduate Division Dissertation Fellowship, UC Santa Barbara' },
  { year: 2016, label: '740,082 SU supercomputing allocation on TACC Stampede (Co-PI), XSEDE' },
  { year: 2015, label: 'Michael Devirian Award for Outstanding Research in Physics, UC Riverside' },
  { year: 2006, label: 'Silver Medal, National Astrophysics Olympiad, Iran' },
];

const teaching = [
  { role: 'Teaching Associate (instructor of record)', course: 'Engineering Dynamics (ME16)', org: 'UC Santa Barbara · Spring 2018' },
  { role: 'Teaching Assistant', course: 'Intermediate Mechanics, Engineering Vibrations, Fluid Mechanics I/II, Statics', org: 'UC Santa Barbara' },
  { role: 'Teaching Assistant', course: 'Physics General Labs (6 classes), General Physics Discussions (12 classes)', org: 'UC Riverside' },
  { role: 'Teaching Assistant', course: 'Orbital Mechanics (5 semesters), Aircraft Design II', org: 'Sharif University of Technology' },
];
---

<Base title="About — Pouria Mistani" description="Experience, research areas, education and awards of Pouria Mistani, a computational physicist who leads work on AI for science and engineering.">
  <section class="about-hero">
    <div class="container-wide">
      <p class="eyebrow">About</p>
      <div class="about-hero-grid">
        <div class="about-portrait">
          <img src="/img/Pouria_random.jpg" alt="Pouria Mistani" />
        </div>
        <div class="about-intro">
          <h1>Computational physicist leading <em>AI for science and engineering</em>.</h1>
          <p class="about-lede">
            I trained first as a physicist and then as a computational scientist. My work combines
            machine learning, applied mathematics, physics-based modeling and scalable software. I use
            these methods to build production systems for scientific and engineering problems.
          </p>
          <p class="about-lede">
            I have taken several research ideas through to deployed platforms. They include
            GPU-accelerated simulation, differentiable physics, agentic AI and scientific applications
            of large language models. At NVIDIA I was the first technical hire on the Clara Discovery
            simulation team, which grew to 14 engineers and researchers. At Voltai I conceived Voltaire,
            an agentic multiphysics platform for 3D-IC design. GPU-accelerated first-principles solvers
            form its core, and AI agents coordinate the workflow around them. I built the initial
            platform, defined its architecture and assembled a team with expertise in AI, computational
            science and semiconductor engineering. I continue to contribute to the core code.
          </p>
          <p class="about-lede">
            In each domain I have worked on how to build simulations that are faithful to the physics
            and large enough to be useful. I have also worked on how to couple AI methods to these
            simulations while preserving the accuracy of the physical model.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="about-manifesto container-narrow">
    <p class="eyebrow">Principles</p>
    <h2>How I choose and conduct research.</h2>
    <ol class="manifesto-list">
      <li>
        <p>I choose problems in which the governing physics is well posed and the scale is industrially relevant.</p>
      </li>
      <li>
        <p>In the systems I build, first-principles solvers determine the accuracy of the results. AI methods handle orchestration and reasoning, and the two parts are designed together.</p>
      </li>
      <li>
        <p>I treat numerical methods, high-performance computing and AI as parts of one technical stack.</p>
      </li>
      <li>
        <p>I evaluate a method on the hardware and at the problem sizes for which it is intended.</p>
      </li>
      <li>
        <p>I look for problems that are scientifically meaningful and that can support a technology and a business.</p>
      </li>
    </ol>
  </section>

  <section class="about-section container-wide">
    <p class="eyebrow">Experience</p>
    <h2>Experience.</h2>
    <ul class="cv-list">
      {experience.map((e) => (
        <li class="cv-row">
          <span class="cv-when mono">{e.years}</span>
          <div class="cv-what">
            <p class="cv-headline">{e.role}</p>
            <p class="cv-sub mono">{e.org}</p>
            <p class="cv-note muted">{e.note}</p>
            {e.links && (
              <p class="cv-links mono">
                {e.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener">{l.label}<span aria-hidden="true"> ↗</span></a>
                ))}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="about-section container-wide">
    <p class="eyebrow">Research areas</p>
    <h2>Research areas.</h2>
    <ul class="areas-list">
      {researchAreas.map((a) => <li class="area mono">{a}</li>)}
    </ul>
    <p class="areas-note muted">
      Applied across semiconductor technology, computational engineering, biophysics, and drug discovery.
    </p>
  </section>

  <section class="about-section container-wide">
    <p class="eyebrow">Education</p>
    <h2>Education.</h2>
    <ul class="cv-list">
      {education.map((e) => (
        <li class="cv-row">
          <span class="cv-when mono">{e.years}</span>
          <div class="cv-what">
            <p class="cv-headline">{e.degree}</p>
            <p class="cv-sub mono">{e.org}</p>
            {e.note && <p class="cv-note muted">{e.note}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="about-section container-wide">
    <p class="eyebrow">Awards & honors</p>
    <h2>Awards and honors.</h2>
    <ul class="cv-list">
      {awards.map((a) => (
        <li class="cv-row">
          <span class="cv-when mono">{a.year}</span>
          <div class="cv-what">
            <p class="cv-headline cv-headline--small">{a.label}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="about-section container-wide">
    <p class="eyebrow">Teaching</p>
    <h2>Teaching.</h2>
    <ul class="cv-list">
      {teaching.map((t) => (
        <li class="cv-row">
          <span class="cv-when mono">{t.org.split(' · ')[1] || ''}</span>
          <div class="cv-what">
            <p class="cv-headline">{t.course}</p>
            <p class="cv-sub mono">{t.role} · {t.org.split(' · ')[0]}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="about-cta container-narrow">
    <p class="eyebrow">Contact</p>
    <h2 class="about-cta-title">
      I can be reached by <a href="mailto:p.a.mistani@gmail.com">email</a>.
    </h2>
  </section>
</Base>

<style>
  .about-hero {
    padding-block: var(--s-24) var(--s-16);
    border-bottom: 1px solid var(--hairline);
  }
  .about-hero-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--s-12);
    align-items: start;
    margin-top: var(--s-8);
  }
  .about-portrait {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--hairline-strong);
    overflow: hidden;
    background: var(--bg-elevated);
  }
  .about-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.02) saturate(0.92);
  }
  .about-intro h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.05;
    margin-bottom: var(--s-6);
  }
  .about-intro h1 em {
    color: var(--accent);
    font-style: italic;
  }
  .about-lede {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    color: var(--ink-muted);
    line-height: 1.7;
    max-width: 60ch;
  }
  .about-lede + .about-lede {
    margin-top: var(--s-4);
  }

  .about-manifesto {
    padding-block: var(--s-16) var(--s-16);
  }
  .about-manifesto h2 {
    margin-bottom: var(--s-8);
  }
  .manifesto-list {
    list-style: none;
    counter-reset: m;
    padding: 0;
  }
  .manifesto-list li {
    counter-increment: m;
    padding: var(--s-6) 0;
    border-top: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: var(--s-6);
    align-items: baseline;
  }
  .manifesto-list li:last-child {
    border-bottom: 1px solid var(--hairline);
  }
  .manifesto-list li::before {
    content: counter(m, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    letter-spacing: 0.06em;
  }
  .manifesto-list p {
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.4;
    color: var(--ink);
    max-width: none;
  }

  .about-section {
    padding-block: var(--s-12);
  }
  .about-section h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-bottom: var(--s-8);
  }
  .cv-list {
    list-style: none;
    padding: 0;
  }
  .cv-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--s-6);
    padding: var(--s-4) 0;
    border-top: 1px solid var(--hairline);
    align-items: baseline;
  }
  .cv-row:last-child {
    border-bottom: 1px solid var(--hairline);
  }
  .cv-when {
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .cv-headline {
    font-size: 1.05rem;
    color: var(--ink);
    margin-bottom: 0.15rem;
  }
  .cv-headline--small {
    font-size: 0.95rem;
  }
  .cv-sub {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
  .cv-note {
    font-size: 0.92rem;
    margin-top: 0.35rem;
  }
  .cv-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
    margin-top: var(--s-2);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .areas-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .area {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--hairline-strong);
    color: var(--ink);
  }
  .areas-note {
    margin-top: var(--s-6);
    font-size: 0.95rem;
  }

  .about-cta {
    padding-block: var(--s-16) var(--s-24);
  }
  .about-cta-title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.15;
  }
  .about-cta-title a {
    color: var(--accent);
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 100% 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
  }

  @media (max-width: 768px) {
    .about-hero-grid { grid-template-columns: 1fr; }
    .about-portrait { max-width: 280px; }
    .cv-row { grid-template-columns: 1fr; gap: var(--s-2); }
    .cv-when { margin-bottom: var(--s-1); }
    .manifesto-list li { grid-template-columns: 1fr; gap: var(--s-2); }
  }
</style>
